{
  "name": "cdk-excavator-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --sort run build && pnpm typecheck",
    "typecheck": "tsc -p packages/cli/tsconfig.build.json --noEmit",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "release:check": "node tools/check-release-version.mjs",
    "check:forbidden": "node tools/check-forbidden-aws-api.mjs",
    "package:verify": "node tools/verify-distribution.mjs",
    "binary:build": "pnpm build && node tools/build-sea.mjs",
    "binary:verify": "node tools/verify-release-binary.mjs"
  },
  "devDependencies": {
    "@cdk-excavator/core": "workspace:*",
    "@cdk-excavator/i18n": "workspace:*",
    "@types/jmespath": "0.15.2",
    "@types/node": "^24.0.10",
    "cdk-excavator": "workspace:*",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.8.3"
  }
}
